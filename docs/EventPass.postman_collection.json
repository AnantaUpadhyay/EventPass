{
  "info": {
    "name": "EventPass \u00b7 Semester Project",
    "description": "EventPass authentication, catalog, Redis reservations, tickets and email delivery. The URL shortener is a separate assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "eventId",
      "value": "evt_neon_nights_2026"
    },
    {
      "key": "seatId",
      "value": "A2"
    },
    {
      "key": "code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 \u00b7 Student login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@college.edu\",\n  \"password\": \"student123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 \u00b7 Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "03 \u00b7 List events",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Catalog available\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"eventId\", pm.response.json().events[0]._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 \u00b7 Event details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/events/{{eventId}}"
      }
    },
    {
      "name": "05 \u00b7 Live seat map",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/booking/seats/{{eventId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Seat map available\", () => pm.response.to.have.status(200));",
              "const seat = pm.response.json().grid.flatMap(r => r.seats).find(s => s.status === \"AVAILABLE\");",
              "if (seat) pm.collectionVariables.set(\"seatId\", seat.seatId);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 \u00b7 Hold a seat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/booking/hold",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"seatId\": \"{{seatId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 \u00b7 Confirm mock checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/booking/confirm",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"seatId\": \"{{seatId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Booking saved\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 \u00b7 My tickets",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/booking/mine",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "09 \u00b7 My email delivery records",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/notifications/mine",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "17 \u00b7 Booking health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/health/booking"
      }
    },
    {
      "name": "18 \u00b7 Catalog metrics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/metrics"
      }
    },
    {
      "name": "19 \u00b7 Booking metrics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/booking/metrics"
      }
    },
    {
      "name": "20 \u00b7 Organizer login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"organizer@college.edu\",\n  \"password\": \"student123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Admin login succeeds\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"adminToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "21 \u00b7 Create event as admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/events",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Campus Session\",\n  \"description\": \"A real API-created event for the lab demo.\",\n  \"category\": \"Workshop\",\n  \"venue\": \"Campus Innovation Lab\",\n  \"date\": \"2099-11-20\",\n  \"time\": \"18:00 IST\",\n  \"price\": 0,\n  \"seatLayout\": {\n    \"rows\": 3,\n    \"seatsPerRow\": 10\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "22 \u00b7 Admin delivery log",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/notifications/logs",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "23 \u00b7 Register a separate student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Student\",\n  \"email\": \"student-{{$timestamp}}@example.test\",\n  \"password\": \"secure-demo-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "24 \u00b7 Release owned hold (use after a new hold, not confirmation)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/booking/release",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"seatId\": \"{{seatId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
