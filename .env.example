# npm run dev creates a real .env with random secrets automatically.
# For Docker-only use: node scripts/setup.js
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=replace-with-a-random-service-key
SEED_DEMO=true
# Local-only demo accounts: student@college.edu and organizer@college.edu
# Password student123. Set SEED_DEMO=false before public deployment.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=EventPass <tickets@eventpass.local>

# Vercel production: configure these in the project dashboard, never in Git.
# MONGO_URI=mongodb+srv://... (services use eventpass_auth/catalog/booking/notifications)
# REDIS_URL=rediss://... (TLS Redis TCP connection, not a REST endpoint)
# SEED_CATALOG=true (seed event listings without creating demo admin accounts)
# CRON_SECRET=... (random token protecting the daily email retry job)
# Configure SMTP_HOST/PORT/SECURE/USER/PASS/FROM for real email delivery.
