{
  "name": "eventpass-monorepo",
  "version": "1.0.0",
  "description": "EventPass: High-Concurrency Ticket & Event Booking Microservices Platform",
  "scripts": {
    "install:all": "npm install",
    "dev": "node scripts/dev.js",
    "build": "npm --workspace client run build",
    "start": "node scripts/dev.js --production",
    "test": "node --test tests/*.test.js",
    "test:integration": "node scripts/integration.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "setup": "node scripts/setup.js"
  },
  "workspaces": [
    "client",
    "services/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}
